# Dominio pubblico del sito, senza slash finale. Obbligatorio: senza, la build fallisce.
NEXT_PUBLIC_SITE_URL=https://titrovano.it

# Resend (https://resend.com) — chiave API
RESEND_API_KEY=
# Mittente: deve appartenere a un dominio verificato su Resend
RESEND_FROM=TiTrovano <prova@titrovano.it>
# Indirizzo che riceve le richieste di prova (anche più indirizzi separati da virgola)
LEAD_TO_EMAIL=

# Google Search Console: solo il valore "content" del meta tag di verifica
GOOGLE_SITE_VERIFICATION=

# Numero WhatsApp per il pulsante della pagina "Scheda Google sempre viva":
# formato internazionale, solo cifre, senza + (es. 393331234567). Se manca, il pulsante porta al modulo.
NEXT_PUBLIC_WHATSAPP_NUMBER=
